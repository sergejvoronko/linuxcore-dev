---
// src/pages/shop/index.astro
// Static now. The page used to call Printify at request time and link to an
// SSR product page whose Buy button posted to /api/checkout, a route that was
// never built - so nothing was purchasable. Orders go through Etsy instead,
// which also removes the Printify token from the request path.
import BaseLayout from '../../layouts/BaseLayout.astro';
import liveProducts from '../../data/merch.json';
// Designs live in a data file so new ones are added without editing this page;
// whether each is buyable still comes from sync-merch.mjs.
import designs from '../../data/merch-designs.json';

const byId = new Map(liveProducts.map((p: any) => [p.id, p]));
const items = designs.map(d => ({ ...d, live: byId.get(d.productId) }));
const liveCount = items.filter(i => i.live).length;
---

<BaseLayout
  title="Shop"
  description="linuxcore.dev merch — t-shirts, mugs, and prints for the homelab community. Printed on demand, ships worldwide."
>
  <main class="shop-page">

    <section class="shop-hero">
      <img src="/images/section-shop.webp" alt="" class="hero-photo" width="1280" height="720" aria-hidden="true" />
      <div class="hero-label"><span class="tb">[</span>shop<span class="tb">]</span></div>
      <h1 class="hero-title">The linuxcore<em class="title-accent"> shop</em></h1>
      <p class="hero-lead">T-shirts, mugs, and prints for people who self-host everything. Printed on demand — ships worldwide.</p>
    </section>

    {liveCount === 0 && (
      <div class="shop-notice">
        The designs are finished and print-ready. Listings go live on Etsy shortly.
      </div>
    )}

    <div class="products-grid">
      {items.map(d => (
        <article class="product-card">
          <div class="product-img-wrap">
            <img src={`/images/merch/${d.slug}.webp`} alt={`${d.name} design`} width={d.w} height={d.h} loading="lazy" />
          </div>
          <div class="product-info">
            <div class="product-name">{d.name}</div>
            <p class="product-blurb">{d.blurb}</p>
            {d.live
              ? <a class="product-buy" href={d.live.url} target="_blank" rel="noopener">Buy on Etsy</a>
              : <span class="product-buy product-buy-off">Not in the store yet</span>}
          </div>
        </article>
      ))}
    </div>

  </main>
</BaseLayout>

<style>
  .shop-page { max-width: var(--wide-w); margin: 0 auto; padding: 3rem 1.5rem 5rem; }

  .shop-hero {
    margin-bottom: 3rem; position: relative; overflow: hidden;
    padding: 3rem 1.5rem 2.5rem;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  .shop-hero .hero-photo {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    opacity: 0.15;
  }
  .shop-hero > :not(.hero-photo) { position: relative; z-index: 1; }
  .hero-label { font-family: var(--font-mono); font-size: 0.78rem; color: var(--amber); margin-bottom: 0.75rem; }
  .tb { opacity: 0.35; }
  .hero-title { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: var(--text-bright); margin-bottom: 0.75rem; line-height: 1.1; }
  .title-accent { font-style: italic; font-weight: 300; color: var(--amber); }
  .hero-lead { font-size: 1.05rem; color: var(--text-mid); max-width: 48ch; line-height: 1.7; }

  .shop-notice { padding: 1rem 1.25rem; background: var(--bg2); border: 1px solid var(--border-mid); border-radius: 6px; font-size: 0.88rem; color: var(--text-mid); margin-bottom: 2rem; }
  .shop-notice code { color: var(--amber); background: var(--bg-code); padding: 0.1em 0.4em; border-radius: 3px; font-family: var(--font-mono); font-size: 0.85em; }

  /* min() keeps the track from forcing a 240px column on a narrower phone,
     which is what pushes the grid wider than the viewport. */
  .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); gap: 1.5rem; }

  .product-card { display: block; text-decoration: none; border-radius: 8px; overflow: hidden; background: var(--bg2); border: 1px solid var(--border); transition: border-color 0.15s, transform 0.15s; }
  .product-card:hover { border-color: var(--amber-border); transform: translateY(-2px); }

  .product-img-wrap { aspect-ratio: 1; overflow: hidden; background: var(--bg3); }
  .product-img-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 14%; transition: transform 0.3s; }
  .product-card:hover .product-img-wrap img { transform: scale(1.04); }

  .product-info { padding: 1rem 1.1rem; }
  .product-name { font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--text-bright); margin-bottom: 0.3rem; }
  .product-price { font-family: var(--font-mono); font-size: 0.78rem; color: var(--amber); }
</style>

<style>
  .product-blurb {
    color: var(--text-dim, #a09482);
    font-size: 0.86rem;
    line-height: 1.6;
    margin: 6px 0 14px;
  }
  .product-buy {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    padding: 9px 16px;
    border: 1px solid var(--amber);
    color: var(--amber);
    text-decoration: none;
    border-radius: 2px;
  }
  .product-buy:hover { background: var(--amber); color: #121212; }
  .product-buy-off {
    border-color: var(--border-amber);
    color: var(--text-dim, #a09482);
    cursor: default;
  }
  .product-buy-off:hover { background: none; color: var(--text-dim, #a09482); }

  @media (max-width: 640px) {
    /* one card per row on a phone, so the artwork gets the full width rather
       than a third of it, and less inset since the card is already small */
    .products-grid { grid-template-columns: 1fr; gap: 1.1rem; }
    .product-img-wrap img { padding: 9%; }
  }
</style>
